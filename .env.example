# Server only. Set in Vercel project environment variables, never in client code.
REDIS_URL=

# Alternative Upstash REST configuration. Use this pair instead of REDIS_URL if preferred.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional local/demo UI mode. Production defaults to live when unset.
VITE_GLITCH_MODE=live

# Optional chain/token overrides. Defaults are Robinhood Chain + current GLITCH token.
GLITCH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
GLITCH_TOKEN_ADDRESS=0x89de619ac9986fa8467d5007413a39136c326e8f

# Optional Redis namespace. Use a different value for isolated test tokens.
GLITCH_REDIS_PREFIX=
